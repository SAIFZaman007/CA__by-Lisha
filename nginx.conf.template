# Coach Auto — client portal. Static SPA + reverse proxy to the API.
#
# --- Which deployment shape is this? -----------------------------------------
#
# Two are supported, and the difference matters more than it looks.
#
#   Same-origin. The browser talks only to this server; `/api/` below proxies
#   to the backend. Leave VITE_API_URL blank and PUBLIC_API_URL blank on the
#   API. Cookies stay first-party, there is no CORS, and the CSP can stay on
#   'self'. This is the simpler of the two and the one to prefer — but it only
#   works if `$api_upstream` below actually resolves to the backend container.
#
#   Split-origin. The browser talks to the API on its own hostname. Set
#   VITE_API_URL here and PUBLIC_API_URL on the API to the same value, and add
#   that origin to the CSP directives marked below.
#
# The failure that produced this file was a half-and-half: VITE_API_URL pointed
# at the API's own hostname while the API still handed out root-relative media
# paths. JSON requests went to the API and worked; every <img> and <video> src
# resolved against *this* origin instead, landed here, and was proxied to an
# upstream that does not answer — which is where the 502s came from. Pick one
# shape and configure both halves of it.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # `img-src` keeps `blob:` because the message composer previews a picked
    # file with URL.createObjectURL before it is uploaded.
    #
    # SPLIT-ORIGIN: when the API answers on its own hostname, private media is
    # cross-origin and 'self' no longer covers it. A CSP-blocked image fails
    # silently apart from a console line, so this is easy to miss. The API
    # origin below must match PUBLIC_API_URL on the backend exactly, scheme
    # included. On a same-origin deployment it is harmless to leave in place.
    # ${API_ORIGIN} is substituted at container start from the environment (see
    # the Dockerfile), so the media origin is configured once rather than baked
    # into an image. It must equal PUBLIC_API_URL on the backend. Empty is fine
    # and correct for a same-origin deployment — 'self' already covers it.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${API_ORIGIN}; media-src 'self' blob: ${API_ORIGIN}; font-src 'self' data:; connect-src 'self' ${API_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # --- API proxy ------------------------------------------------------------
    #
    # `^~` is load-bearing. nginx tests regex locations before prefix ones, so
    # without it the `\.(png|jpe?g|...)$` block further down would capture any
    # API path ending in an image extension and try to serve it from the static
    # root. `^~` stops the regex search once this prefix matches, which keeps
    # every /api/ request on the proxy where it belongs.
    location ^~ /api/ {
        # Resolve the upstream at request time via Docker's internal DNS, so a
        # backend that is slow to start does not stop nginx from booting.
        #
        # If this name is wrong, nginx has nothing to proxy to and answers 502.
        # Confirm it against the backend's actual service name on this network
        # (`docker network inspect <network>`) rather than assuming — in Coolify
        # the service name is not always the one written in the compose file.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Range requests must reach the backend untouched. The tutorial player
        # seeks by asking for byte ranges and the API answers 206 with a
        # Content-Range; a proxy that swallows either end of that exchange
        # turns scrubbing into a video that will not seek.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        # Stream both directions rather than buffering. With buffering on,
        # nginx spools a whole response to a temp file before forwarding a
        # byte, which delays the first frame of every video and turns a large
        # upload into a disk write on the proxy as well as on the API.
        proxy_buffering off;
        proxy_request_buffering off;

        # A tutorial upload is legitimately large and legitimately slow. This
        # ceiling must stay at or above MAX_VIDEO_UPLOAD_MB on the API,
        # otherwise nginx rejects the upload with a 413 the backend never sees
        # and never gets to explain. 512 MB limit, plus multipart framing.
        client_max_body_size 550M;
        client_body_timeout 600s;

        # Long enough for a coach on gym wi-fi to finish pushing a video.
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # Search engines fetch these two from the site root, not from the API.
    #
    # Both are generated by the backend rather than shipped as static files,
    # because both list database-backed content — the live coaching tiers, the
    # published gallery — and a file baked into the frontend build goes stale
    # the first time the coach publishes a photo. Proxying keeps the canonical
    # URL (`/sitemap.xml`) while the content stays current.
    location = /sitemap.xml {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $seo_upstream ${API_UPSTREAM};
        proxy_pass $seo_upstream/api/v1/meta/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /robots.txt {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $seo_upstream ${API_UPSTREAM};
        proxy_pass $seo_upstream/api/v1/meta/robots.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Static build artefacts only. `^~ /api/` above wins before nginx reaches
    # this regex, so an API route can never be mistaken for a file on disk.
    location ~* \.(png|jpe?g|webp|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
    }

    location /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}