# Coach Auto — client portal. Static SPA + reverse proxy to the API.
#
# --- Which deployment shape is this? -----------------------------------------
#
# Two are supported, and the difference matters more than it looks.
#
#   Same-origin. The browser talks only to this server; `/api/` below proxies
#   to the backend. Leave VITE_API_URL blank and PUBLIC_API_URL blank on the
#   API. Cookies stay first-party, there is no CORS, and the CSP can stay on
#   'self'. This is the simpler of the two and the one to prefer — but it only
#   works if `$api_upstream` below actually resolves to the backend container.
#
#   Split-origin. The browser talks to the API on its own hostname. Set
#   VITE_API_URL here and PUBLIC_API_URL on the API to the same value, and add
#   that origin to the CSP directives marked below.
#
# The failure that produced this file was a half-and-half: VITE_API_URL pointed
# at the API's own hostname while the API still handed out root-relative media
# paths. JSON requests went to the API and worked; every <img> and <video> src
# resolved against *this* origin instead, landed here, and was proxied to an
# upstream that does not answer — which is where the 502s came from. Pick one
# shape and configure both halves of it.

# Crawler responses are cached here so a sitemap fetch never depends on the API
# being awake at that exact second. `proxy_cache_path` is an http-level
# directive, and this file is included from inside `http {}` — see the image's
# /etc/nginx/nginx.conf. One megabyte of keys is thousands of entries; the
# sitemap is one of them.
proxy_cache_path /var/cache/nginx/seo levels=1:2 keys_zone=seo_cache:1m
                 max_size=16m inactive=24h use_temp_path=off;

server {
    listen 8080;
    server_name _;

    # Behind Coolify's TLS proxy this container only sees plain http on :8080.
    # Relative Location headers keep every redirect on https://<site>/…
    # instead of sending crawlers to http://<site>:8080/….
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Google Analytics 4 (src/lib/analytics.js): gtag.js from
    # www.googletagmanager.com, hits to *.google-analytics.com /
    # *.analytics.google.com — Google's documented CSP for GA4. No inline
    # script is allowed: the gtag() queue lives in a same-origin module.
    #
    # `img-src` keeps `blob:` because the message composer previews a picked
    # file with URL.createObjectURL before it is uploaded.
    #
    # https://res.cloudinary.com is where every uploaded image and video now
    # lives (see the API's app/services/storage.py). Public artwork is linked
    # directly; private media arrives via a 307 from the API to a signed CDN
    # URL — the redirect target is checked against these directives too.
    #
    # `frame-src` + the YouTube/Vimeo thumbnail hosts: the client portal's
    # tutorial library embeds hosted videos in an <iframe>. With no frame-src
    # the policy fell back to default-src 'self' and every hosted tutorial was
    # blocked for clients (the coach dashboard already allowed them).
    #
    # SPLIT-ORIGIN: when the API answers on its own hostname, private media is
    # cross-origin and 'self' no longer covers it. A CSP-blocked image fails
    # silently apart from a console line, so this is easy to miss. The API
    # origin below must match PUBLIC_API_URL on the backend exactly, scheme
    # included. On a same-origin deployment it is harmless to leave in place.
    # ${API_ORIGIN} is substituted at container start from the environment (see
    # the Dockerfile), so the media origin is configured once rather than baked
    # into an image. It must equal PUBLIC_API_URL on the backend. Empty is fine
    # and correct for a same-origin deployment — 'self' already covers it.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://i.ytimg.com https://i.vimeocdn.com https://*.google-analytics.com https://*.googletagmanager.com ${API_ORIGIN}; media-src 'self' blob: https://res.cloudinary.com ${API_ORIGIN}; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com ${API_ORIGIN}; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Declare UTF-8 on every text response (robots.txt was rendering its em
    # dash as "â€”" because text/plain went out with no charset).
    charset utf-8;
    charset_types text/plain text/css text/xml application/xml application/javascript
                  application/json application/manifest+json image/svg+xml;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript application/json
               application/xml application/manifest+json application/ld+json image/svg+xml;

    # --- API proxy ------------------------------------------------------------
    #
    # `^~` is load-bearing. nginx tests regex locations before prefix ones, so
    # without it the `\.(png|jpe?g|...)$` block further down would capture any
    # API path ending in an image extension and try to serve it from the static
    # root. `^~` stops the regex search once this prefix matches, which keeps
    # every /api/ request on the proxy where it belongs.
    location ^~ /api/ {
        # Resolve the upstream at request time via Docker's internal DNS, so a
        # backend that is slow to start does not stop nginx from booting.
        #
        # If this name is wrong, nginx has nothing to proxy to and answers 502.
        # Confirm it against the backend's actual service name on this network
        # (`docker network inspect <network>`) rather than assuming — in Coolify
        # the service name is not always the one written in the compose file.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $api_upstream ${API_UPSTREAM};

        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # Range requests must reach the backend untouched. The tutorial player
        # seeks by asking for byte ranges and the API answers 206 with a
        # Content-Range; a proxy that swallows either end of that exchange
        # turns scrubbing into a video that will not seek.
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        # Stream both directions rather than buffering. With buffering on,
        # nginx spools a whole response to a temp file before forwarding a
        # byte, which delays the first frame of every video and turns a large
        # upload into a disk write on the proxy as well as on the API.
        proxy_buffering off;
        proxy_request_buffering off;

        # A tutorial upload is legitimately large and legitimately slow. This
        # ceiling must stay at or above MAX_VIDEO_UPLOAD_MB on the API,
        # otherwise nginx rejects the upload with a 413 the backend never sees
        # and never gets to explain. 512 MB limit, plus multipart framing.
        client_max_body_size 550M;
        client_body_timeout 600s;

        # Long enough for a coach on gym wi-fi to finish pushing a video.
        proxy_connect_timeout 10s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
    }

    # --- Crawler files ----------------------------------------------------------
    #
    # robots.txt is a static file written at build time (scripts/prerender.mjs)
    # from VITE_SITE_URL. It used to be proxied to the API — and Google treats a
    # robots.txt that answers 5xx or times out as "do not crawl this site at
    # all". A file on disk can never be down while the site itself is up.
    location = /robots.txt {
        expires 1h;
        try_files /robots.txt =404;
    }

    # The sitemap comes live from the API (it lists the coach's current
    # programmes and gallery), with the build-time copy as an automatic
    # fallback, so a slow or restarting API never serves crawlers an error.
    #
    # Search Console reports "Couldn't fetch" for ANY hiccup on this one URL —
    # a timeout, a 4xx, a backend mid-restart — and then stops reading the
    # sitemap until it is resubmitted. So the request Google makes must not be
    # able to fail:
    #
    #   1. A cached copy answers most fetches outright: no API call at all.
    #   2. A stale copy is served while a refresh happens in the background,
    #      and whenever the API errors, times out or rate-limits.
    #   3. Any status other than a good 200 falls through to the sitemap
    #      written into this image at build time, which lists every page and
    #      programme that existed at deploy. A crawler gets XML either way.
    #
    # `proxy_hide_header` drops the API's own caching and robots headers: they
    # describe an API response, not a document meant to be read by crawlers.
    location = /sitemap.xml {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $seo_upstream ${API_UPSTREAM};
        proxy_pass $seo_upstream/api/v1/meta/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";

        proxy_connect_timeout 2s;
        proxy_send_timeout 4s;
        proxy_read_timeout 4s;

        proxy_cache seo_cache;
        proxy_cache_key "sitemap";
        proxy_cache_valid 200 1h;
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale error timeout updating
                              http_403 http_429 http_500 http_502 http_503 http_504;

        proxy_hide_header Cache-Control;
        proxy_hide_header X-Robots-Tag;
        proxy_hide_header Content-Security-Policy;
        expires 1h;

        proxy_intercept_errors on;
        error_page 400 401 403 404 405 408 429 500 501 502 503 504 = @sitemap_fallback;
    }

    # The build-time sitemap: a real file on disk, which cannot be slow and
    # cannot be down while this server is answering at all.
    location @sitemap_fallback {
        expires 1h;
        try_files /sitemap.xml =404;
    }

    # llms.txt / llms-full.txt: plain Markdown for AI assistants (llmstxt.org).
    location ~ ^/llms(-full)?\.txt$ {
        expires 1h;
        try_files $uri =404;
    }

    # IndexNow key file (<site>/<key>.txt), answered by the API only for the
    # configured INDEXNOW_KEY — every other name is a 404. Must stay AFTER the
    # llms.txt block above (regex locations match in order).
    location ~ "^/([A-Za-z0-9-]{8,128})\.txt$" {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $seo_upstream ${API_UPSTREAM};
        proxy_pass $seo_upstream/api/v1/meta/indexnow/$1.txt;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    # Agent/registry discovery files: a real file or a real 404 — never the
    # SPA shell, which a validator would read as a malformed manifest.
    location ^~ /.well-known/ {
        try_files $uri =404;
    }

    # --- Static assets --------------------------------------------------------
    #
    # `add_header` inside a location discards every add_header inherited from
    # the server block (the security headers and CSP above). That is fine for
    # fingerprinted assets and images, which a CSP does not govern — and it is
    # why the HTML locations further down use `expires` instead of add_header.

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # Static build artefacts only. `^~ /api/` above wins before nginx reaches
    # this regex, so an API route can never be mistaken for a file on disk.
    location ~* \.(png|jpe?g|webp|avif|svg|ico|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public" always;
        add_header X-Content-Type-Options "nosniff" always;
        access_log off;
    }

    # --- HTML documents ---------------------------------------------------------
    #
    # Public pages are prerendered at build time into <route>/index.html, so a
    # crawler (or a phone) gets the full page without running JavaScript.
    #
    # `expires epoch` (Cache-Control: no-cache) instead of `add_header`: it
    # keeps every HTML response revalidating after a deploy WITHOUT dropping
    # the server-level security headers and CSP above, which any add_header
    # in a location block would silently discard.

    location = /index.html {
        expires epoch;
    }

    location = /app.html {
        expires epoch;
    }

    # Routes that only exist in the browser (account screens, client portal,
    # checkout return pages): the empty SPA shell, status 200.
    location ~ ^/(portal|login|register|forgot-password|reset-password|checkout)(/|$) {
        expires epoch;
        try_files /app.html =404;
    }

    # A programme published after the last build has no prerendered page yet;
    # the shell renders it client-side until the next deploy prerenders it.
    location ~ ^/programs/[a-z0-9-]+/?$ {
        expires epoch;
        try_files $uri/index.html /app.html;
    }

    # --- Legacy URLs from the previous WordPress site ---------------------------
    #
    # Search engines still hold URLs from the site that used to live on this
    # domain (Bing lists /beginner-plan). A permanent redirect passes whatever
    # standing those URLs earned to the current pages; WordPress internals get
    # 410 Gone so crawlers drop them quickly instead of retrying a 404.
    location ~ ^/(beginner|intermediate|advanced)-plan/?$ {
        return 301 /programs;
    }

    location ~ ^/(wp-admin|wp-content|wp-includes|wp-json|feed|comments|category|tag|author)(/|$) {
        return 410;
    }

    location ~ ^/(wp-login|xmlrpc|wp-cron)\.php$ {
        return 410;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    # Everything else: a prerendered page, a static file, or a genuine 404.
    # The 404 still carries the SPA shell (the app shows its "page not found"
    # screen), but the status tells search engines the URL does not exist,
    # instead of a soft-404 "200 OK" for every mistyped link.
    location / {
        expires epoch;
        try_files $uri $uri/index.html =404;
        error_page 404 /app.html;
    }
}